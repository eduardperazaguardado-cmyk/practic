Algoritmo SolicitarNumero_1_10
    Definir numero Como Entero
    
    Escribir "Ingrese un número del 1 al 10:"
    Leer numero
    
    Mientras numero >= 1 Y numero <= 10 Hacer
        Escribir "Numero correcto "
        Escribir "Ingrese otro número del 1 al 10:"
        Leer numero
    FinMientras
    
    Escribir "Número invalido"
    
FinAlgoritmo